extends layout

block content
  main(class="main")
    if isAppAvailable
      section(class="hero")
        div(class="text-container")
          h1 Lazy Dates
          p Whether you're looking for lasting love or a meaningful conversation, we're here to help you meet someone who truly gets you. Join a space where kindness, honesty, and shared values lead the way.
          button(type="button") Join Now
    else
      section(class="hero")
        div(class="text-container")
        p Sorry, this app is unavailable.

